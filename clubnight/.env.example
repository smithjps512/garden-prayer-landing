# Supabase (anon/publishable key only — the site can INSERT signups, never read them)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Admin key: unlocks /admin and the read functions in the database (must match clubnight_config.admin_key)
ADMIN_KEY=change-me

# Vercel cron calls /api/digest with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=change-me

# Email
RESEND_API_KEY=re_...
EMAIL_FROM="BMS Club Night <clubnight@doubleblaze.solutions>"
DIGEST_CC=jamessmith@mcps.org

# Dates (YYYY-MM-DD, America/New_York). Digest goes out the morning after CLUB_NIGHT_DATE.
CLUB_NIGHT_DATE=
SITE_CLOSES_AT=

# Public site URL (used in emails)
SITE_URL=https://bms-club-night.vercel.app
